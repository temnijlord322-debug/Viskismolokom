// C++ / Windows 11 / MSVC
// Безопасная демонстрационная версия
//
// Функционал:
//  - полноэкранное окно с вводом пароля
//  - пароль: 3252
//  - 40 окон "Hello World!" поверх основного окна
//  - после правильного пароля закрываются окна только этой программы
//  - системные клавиши и мышь НЕ блокируются
//  - ошибки запуска показываются пользователю

#include <windows.h>
#include <string>

#pragma comment(lib, "user32.lib")
#pragma comment(lib, "gdi32.lib")

#define ID_EDIT 1001
#define ID_OK   1002

const char LOCK_CLASS[]  = "DemoLockScreen";
const char HELLO_CLASS[] = "DemoHelloWorld";

HWND g_lockWnd = nullptr;

// ============================================================
// Пароль
// ============================================================

const char PASSWORD[] = "3252";

// ============================================================
// Показать ошибку Windows
// ============================================================

void ShowWindowsError(const char* operation)
{
    DWORD error = GetLastError();

    char message[512] = {};

    wsprintfA(
        message,
        "%s\n\nКод ошибки Windows: %lu",
        operation,
        error
    );

    MessageBoxA(
        nullptr,
        message,
        "Ошибка",
        MB_OK | MB_ICONERROR
    );
}

// ============================================================
// Закрыть только окна текущего процесса
// ============================================================

BOOL CALLBACK CloseOurWindows(HWND hwnd, LPARAM)
{
    DWORD pid = 0;

    GetWindowThreadProcessId(hwnd, &pid);

    if (pid == GetCurrentProcessId())
    {
        DestroyWindow(hwnd);
    }

    return TRUE;
}

// ============================================================
// Окно Hello World
// ============================================================

LRESULT CALLBACK HelloProc(
    HWND hwnd,
    UINT msg,
    WPARAM wParam,
    LPARAM lParam)
{
    switch (msg)
    {
    case WM_PAINT:
    {
        PAINTSTRUCT ps;

        HDC hdc = BeginPaint(hwnd, &ps);

        RECT rc;
        GetClientRect(hwnd, &rc);

        SetBkMode(hdc, TRANSPARENT);
        SetTextColor(
            hdc,
            RGB(0, 255, 0)
        );

        for (int i = 0; i < 10; ++i)
        {
            RECT line = rc;

            line.top =
                10 + i * 22;

            line.bottom =
                line.top + 22;

            DrawTextA(
                hdc,
                "Hello World!",
                -1,
                &line,
                DT_CENTER |
                DT_SINGLELINE
            );
        }

        EndPaint(hwnd, &ps);

        return 0;
    }

    case WM_ERASEBKGND:
        return 1;

    case WM_CLOSE:
        DestroyWindow(hwnd);
        return 0;
    }

    return DefWindowProcA(
        hwnd,
        msg,
        wParam,
        lParam
    );
}

// ============================================================
// Главное окно с паролем
// ============================================================

LRESULT CALLBACK LockProc(
    HWND hwnd,
    UINT msg,
    WPARAM wParam,
    LPARAM lParam)
{
    switch (msg)
    {
    case WM_CREATE:
    {
        int sw =
            GetSystemMetrics(
                SM_CXSCREEN
            );

        // ----------------------------------------------------
        // Текст
        // ----------------------------------------------------

        HWND label = CreateWindowA(
            "STATIC",
            "ДЕМОНСТРАЦИОННЫЙ ЭКРАН\n\nВведите пароль:",
            WS_VISIBLE |
            WS_CHILD |
            SS_CENTER,
            0,
            200,
            sw,
            100,
            hwnd,
            nullptr,
            nullptr,
            nullptr
        );

        if (!label)
        {
            ShowWindowsError(
                "Не удалось создать текстовое поле."
            );
        }

        // ----------------------------------------------------
        // Поле пароля
        // ----------------------------------------------------

        HWND edit = CreateWindowExA(
            WS_EX_CLIENTEDGE,
            "EDIT",
            "",
            WS_VISIBLE |
            WS_CHILD |
            ES_PASSWORD |
            ES_CENTER,
            sw / 2 - 150,
            320,
            300,
            32,
            hwnd,
            (HMENU)ID_EDIT,
            nullptr,
            nullptr
        );

        if (!edit)
        {
            ShowWindowsError(
                "Не удалось создать поле пароля."
            );
        }

        // ----------------------------------------------------
        // Кнопка
        // ----------------------------------------------------

        HWND button = CreateWindowA(
            "BUTTON",
            "РАЗБЛОКИРОВАТЬ",
            WS_VISIBLE |
            WS_CHILD |
            BS_DEFPUSHBUTTON,
            sw / 2 - 100,
            370,
            200,
            40,
            hwnd,
            (HMENU)ID_OK,
            nullptr,
            nullptr
        );

        if (!button)
        {
            ShowWindowsError(
                "Не удалось создать кнопку."
            );
        }

        if (edit)
        {
            SetFocus(edit);
        }

        return 0;
    }

    // ========================================================
    // Нажатие кнопки
    // ========================================================

    case WM_COMMAND:
    {
        if (LOWORD(wParam) == ID_OK)
        {
            HWND edit =
                GetDlgItem(
                    hwnd,
                    ID_EDIT
                );

            char buf[64] = {};

            if (edit)
            {
                GetWindowTextA(
                    edit,
                    buf,
                    sizeof(buf)
                );
            }

            // ------------------------------------------------
            // Проверяем пароль
            // ------------------------------------------------

            if (std::string(buf) == PASSWORD)
            {
                // Закрываем только окна
                // нашего процесса.
                EnumWindows(
                    CloseOurWindows,
                    0
                );

                PostQuitMessage(0);
            }
            else
            {
                if (edit)
                {
                    SetWindowTextA(
                        edit,
                        ""
                    );
                }

                MessageBoxA(
                    hwnd,
                    "Неверный пароль.",
                    "Ошибка",
                    MB_OK |
                    MB_ICONERROR
                );
            }

            return 0;
        }

        break;
    }

    // ========================================================
    // Обычное закрытие
    // ========================================================

    case WM_CLOSE:
        DestroyWindow(hwnd);
        return 0;

    case WM_DESTROY:
        PostQuitMessage(0);
        return 0;
    }

    return DefWindowProcA(
        hwnd,
        msg,
        wParam,
        lParam
    );
}

// ============================================================
// WinMain
// ============================================================

int WINAPI WinMain(
    HINSTANCE hInst,
    HINSTANCE,
    LPSTR,
    int)
{
    // ========================================================
    // Размер экрана
    // ========================================================

    int sw =
        GetSystemMetrics(
            SM_CXSCREEN
        );

    int sh =
        GetSystemMetrics(
            SM_CYSCREEN
        );

    // ========================================================
    // Регистрируем главное окно
    // ========================================================

    WNDCLASSA wcLock = {};

    wcLock.lpfnWndProc =
        LockProc;

    wcLock.hInstance =
        hInst;

    wcLock.lpszClassName =
        LOCK_CLASS;

    wcLock.hbrBackground =
        CreateSolidBrush(
            RGB(10, 10, 10)
        );

    wcLock.hCursor =
        LoadCursorA(
            nullptr,
            IDC_ARROW
        );

    if (!RegisterClassA(&wcLock))
    {
        DWORD error =
            GetLastError();

        // ERROR_CLASS_ALREADY_EXISTS
        // можно считать некритичной ошибкой.
        if (error != ERROR_CLASS_ALREADY_EXISTS)
        {
            ShowWindowsError(
                "Не удалось зарегистрировать класс главного окна."
            );

            return 1;
        }
    }

    // ========================================================
    // Регистрируем Hello World
    // ========================================================

    WNDCLASSA wcHello = {};

    wcHello.lpfnWndProc =
        HelloProc;

    wcHello.hInstance =
        hInst;

    wcHello.lpszClassName =
        HELLO_CLASS;

    wcHello.hbrBackground =
        nullptr;

    wcHello.hCursor =
        LoadCursorA(
            nullptr,
            IDC_ARROW
        );

    if (!RegisterClassA(&wcHello))
    {
        DWORD error =
            GetLastError();

        if (error != ERROR_CLASS_ALREADY_EXISTS)
        {
            ShowWindowsError(
                "Не удалось зарегистрировать класс Hello World."
            );

            return 1;
        }
    }

    // ========================================================
    // Создаём главное окно
    // ========================================================

    g_lockWnd =
        CreateWindowExA(
            0,
            LOCK_CLASS,
            "Demo Lock Screen",
            WS_POPUP |
            WS_VISIBLE,
            0,
            0,
            sw,
            sh,
            nullptr,
            nullptr,
            hInst,
            nullptr
        );

    if (!g_lockWnd)
    {
        ShowWindowsError(
            "Не удалось создать главное окно."
        );

        return 1;
    }

    // ========================================================
    // Создаём Hello World окна
    // ========================================================

    const int HELLO_COUNT = 40;

    for (int i = 0;
         i < HELLO_COUNT;
         ++i)
    {
        const int w = 300;
        const int h = 250;

        int maxX =
            (sw > w)
            ? sw - w
            : 1;

        int maxY =
            (sh > h)
            ? sh - h
            : 1;

        int x =
            (i * 37) % maxX;

        int y =
            (i * 53) % maxY;

        HWND hello =
            CreateWindowExA(
                WS_EX_TOPMOST |
                WS_EX_TOOLWINDOW |
                WS_EX_LAYERED,
                HELLO_CLASS,
                "",
                WS_POPUP |
                WS_VISIBLE,
                x,
                y,
                w,
                h,
                nullptr,
                nullptr,
                hInst,
                nullptr
            );

        if (!hello)
        {
            // Не завершаем программу из-за одного
            // не создавшегося Hello World окна.
            continue;
        }

        // ----------------------------------------------------
        // Полупрозрачность
        // ----------------------------------------------------

        SetLayeredWindowAttributes(
            hello,
            0,
            200,
            LWA_ALPHA
        );

        // ----------------------------------------------------
        // Поверх главного окна
        // ----------------------------------------------------

        SetWindowPos(
            hello,
            HWND_TOPMOST,
            0,
            0,
            0,
            0,
            SWP_NOMOVE |
            SWP_NOSIZE |
            SWP_SHOWWINDOW
        );
    }

    // ========================================================
    // Цикл сообщений
    // ========================================================

    MSG msg = {};

    while (
        GetMessageA(
            &msg,
            nullptr,
            0,
            0
        ) > 0)
    {
        TranslateMessage(&msg);

        DispatchMessageA(&msg);
    }

    // ========================================================
    // Очистка
    // ========================================================

    if (wcLock.hbrBackground)
    {
        DeleteObject(
            wcLock.hbrBackground
        );
    }

    return 0;
}
